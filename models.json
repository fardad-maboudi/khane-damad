        "allDay": {
          "type": "boolean",
          "label": "تمام روز",
          "description": "آیا کل روز را در بر می‌گیرد",
          "default": false
        },
        "startTime": {
          "type": "string",
          "label": "ساعت شروع",
          "description": "ساعت شروع در حالت غیر تمام‌روز"
        },
        "endTime": {
          "type": "string",
          "label": "ساعت پایان",
          "description": "ساعت پایان در حالت غیر تمام‌روز"
        },
        "kind": {
          "type": "string",
          "label": "نوع",
          "description": "دلیل دسته‌بندی‌شده عدم حضور",
          "enum": [
            "vacation",
            "holiday",
            "closure",
            "sick",
            "maintenance",
            "other"
          ],
          "enumLabels": {
            "vacation": "مرخصی",
            "holiday": "تعطیل رسمی",
            "closure": "تعطیلی سالن",
            "sick": "مرخصی استعلاجی",
            "maintenance": "تعمیر و نگهداری",
            "other": "سایر"
          },
          "default": "vacation"
        },
        "recurrence": {
          "type": "string",
          "label": "تکرار",
          "description": "الگوی تکرار بازه مرخصی",
