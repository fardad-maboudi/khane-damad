          "enumLabels": {
            "in_person": "حضوری",
            "phone": "تلفنی",
            "google_meet": "آنلاین"
          },
          "default": "in_person"
        },
        "durationMinutes": {
          "type": "number",
          "label": "مدت زمان (دقیقه)",
          "description": "مدت زمان انجام خدمت به دقیقه",
