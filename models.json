        },
        "bufferBeforeMinutes": {
          "type": "number",
          "label": "زمان آماده‌سازی قبل",
          "description": "فاصله زمانی قبل از شروع نوبت به دقیقه",
          "min": 0,
          "default": 0
        },
        "bufferAfterMinutes": {
          "type": "number",
          "label": "زمان استراحت بعد",
          "description": "فاصله زمانی بعد از اتمام نوبت به دقیقه",
          "min": 0,
          "default": 0
        },
        "price": {
          "type": "number",
          "label": "تعرفه",
          "description": "مبلغ خدمت",
          "min": 0
        },
        "currency": {
          "type": "string",
          "label": "واحد پول",
          "description": "واحد مبلغ خدمت",
          "enum": [
            "IRT",
            "IRR"
          ],
          "enumLabels": {
            "IRT": "تومان",
            "IRR": "ریال"
          },
          "default": "IRT"
        },
        "depositAmount": {
          "type": "number",
          "label": "مبلغ بیعانه",
          "description": "پیش‌پرداخت مورد نیاز برای ثبت نوبت",
          "min": 0
        },
        "capacity": {
          "type": "number",
          "label": "ظرفیت",
          "description": "تعداد نفرات قابل پذیرش در یک نوبت",
          "min": 1,
          "default": 1
        },
        "image": {
          "type": "string",
          "label": "تصویر خدمت",
          "description": "نشانی تصویر نمایش‌داده‌شده در کارت خدمت",
          "format": "image"
        },
        "resourceIds": {
          "type": "array",
          "itemType": "objectId",
          "relationTarget": "booking_resource",
          "label": "آرایشگرهای مجاز",
          "description": "لیست آرایشگرهایی که این خدمت را ارائه می‌دهند"
        },
        "package": {
          "type": "object",
          "label": "بسته چندجلسه‌ای",
          "description": "تنظیمات بسته اعتباری چندجلسه‌ای برای این خدمت"
        },
        "requiresConfirmation": {
          "type": "boolean",
          "label": "نیازمند تأیید دستی",
          "description": "آیا نوبت پس از ثبت منتظر تأیید سالن بماند",
          "default": false
        },
        "autoConfirm": {
          "type": "boolean",
          "label": "تأیید خودکار",
          "description": "تأیید خودکار نوبت بلافاصله پس از ثبت",
          "default": false
        },
        "color": {
          "type": "string",
          "label": "رنگ",
          "description": "رنگ نمایش خدمت در تقویم"
        },
        "location": {
          "type": "string",
          "label": "محل ارائه",
          "description": "آدرس یا بخش سالن"
        },
        "sortOrder": {
          "type": "number",
          "label": "ترتیب نمایش",
          "description": "اولویت نمایش در کاتالوگ خدمات",
          "default": 0
        },
        "active": {
          "type": "boolean",
          "label": "فعال",
          "description": "آیا خدمت برای رزرو فعال است",
          "default": true
        }
      }
    }
  },
  {
    "name": "booking_schedule",
    "schemaDefinition": {
      "label": "برنامه کاری",
      "description": "ساعات کاری هفتگی به ازای هر آرایشگر و خدمت",
      "required": [
        "resource",
        "weekday",
        "startTime",
        "endTime"
      ],
      "properties": {
        "resource": {
          "type": "objectId",
          "relationTarget": "booking_resource",
          "label": "آرایشگر",
          "description": "آرایشگر یا منبع مربوط به این برنامه کاری"
        },
        "service": {
          "type": "objectId",
          "relationTarget": "booking_service",
          "label": "خدمت",
          "description": "خدمت مرتبط با این برنامه کاری"
        },
        "weekday": {
          "type": "number",
          "label": "روز هفته",
          "description": "شماره روز هفته از ۰ (یکشنبه) تا ۶ (شنبه)",
          "min": 0,
          "max": 6
        },
        "startTime": {
          "type": "string",
          "label": "ساعت شروع",
          "description": "ساعت شروع کار در قالب HH:mm"
        },
        "endTime": {
          "type": "string",
          "label": "ساعت پایان",
          "description": "ساعت پایان کار در قالب HH:mm"
        },
        "slotIntervalMinutes": {
          "type": "number",
          "label": "فاصله اسلات‌ها (دقیقه)",
          "description": "گام زمانی تولید اسلات‌های آزاد",
          "min": 5,
          "default": 30
        },
        "effectiveFrom": {
          "type": "date",
          "label": "شروع اعتبار",
          "description": "تاریخ شروع اعتبار این برنامه"
        },
        "effectiveUntil": {
          "type": "date",
          "label": "پایان اعتبار",
          "description": "تاریخ پایان اعتبار این برنامه"
        },
        "active": {
          "type": "boolean",
          "label": "فعال",
          "description": "آیا این برنامه در تولید نوبت لحاظ شود",
          "default": true
        }
      }
    }
  },
  {
    "name": "booking_timeoff",
