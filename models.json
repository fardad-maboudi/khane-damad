          "default": 12
        },
        "rescheduleWindowHours": {
          "type": "number",
          "label": "مهلت جابه‌جایی (ساعت)",
          "description": "حداقل ساعت مانده به نوبت برای تغییر زمان",
          "min": 0,
          "default": 12
        },
        "allowGuestBooking": {
          "type": "boolean",
          "label": "رزرو مهمان",
          "description": "امکان ثبت نوبت بدون نیاز به ورود حساب کاربری",
          "default": true
        },
        "requirePhone": {
          "type": "boolean",
          "label": "الزام شماره موبایل",
          "description": "اجباری بودن شماره تماس هنگام رزرو",
          "default": true
        },
        "autoConfirm": {
          "type": "boolean",
          "label": "تأیید خودکار",
          "description": "تأیید خودکار نوبت‌ها پس از ثبت",
          "default": false
        },
        "depositRequired": {
          "type": "boolean",
          "label": "نیاز به بیعانه",
          "description": "دریافت بیعانه هنگام ثبت نوبت",
          "default": false
        },
        "maxActivePerClient": {
          "type": "number",
          "label": "سقف نوبت فعال مشتری",
          "description": "حداکثر تعداد نوبت فعال هم‌زمان برای یک مشتری",
          "min": 1,
          "default": 3
        },
        "reminderOffsetsMinutes": {
          "type": "array",
          "itemType": "number",
          "label": "زمان‌های یادآوری (دقیقه)",
          "description": "فواصل زمانی ارسال یادآور پیش از نوبت (منفی به دقیقه)"
