        "cancellationPolicyText": {
          "type": "string",
          "label": "متن قوانین لغو",
          "description": "توضیح قوانین لغو و جابه‌جایی برای نمایش به مشتری"
        },
        "workingHoursNote": {
          "type": "string",
          "label": "توضیح ساعات کاری",
          "description": "متن ساعات کاری سالن"
        }
      }
    }
  },
