          "default": 21
        },
        "slotIntervalMinutes": {
          "type": "number",
          "label": "فاصله اسلات پیش‌فرض (دقیقه)",
          "description": "گام زمانی پیش‌فرض برای تولید زمان‌های خالی",
          "min": 5,
          "default": 30
        },
        "cancellationWindowHours": {
          "type": "number",
          "label": "مهلت لغو رایگان (ساعت)",
