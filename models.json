            "none",
            "daily",
            "weekly",
            "monthly",
            "yearly"
          ],
          "enumLabels": {
            "none": "بدون تکرار",
            "daily": "روزانه",
            "weekly": "هفتگی",
            "monthly": "ماهانه",
            "yearly": "سالانه"
          },
          "default": "none"
        },
        "repeatUntil": {
          "type": "date",
          "label": "تکرار تا تاریخ",
          "description": "تاریخ پایان تکرار"
        },
        "repeatsAnnually": {
          "type": "boolean",
          "label": "تکرار سالانه",
          "description": "تکرار خودکار در هر سال",
          "default": false
        },
        "reason": {
          "type": "string",
          "label": "توضیح",
          "description": "علت مرخصی یا تعطیلی"
        }
      }
    }
  },
  {
    "name": "booking_setting",
    "schemaDefinition": {
      "label": "تنظیمات رزرو",
