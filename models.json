[
  {
    "name": "booking_resource",
    "schemaDefinition": {
      "label": "آرایشگرها و منابع",
      "description": "اساتید آرایشگر، صندلی‌ها و منابع قابل رزرو سالن",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "label": "نام",
          "description": "نام کامل آرایشگر یا عنوان منبع",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "label": "نوع منبع",
          "description": "دسته‌بندی منبع قابل رزرو",
          "enum": [
            "staff",
            "chair",
            "room",
            "table",
            "court",
            "equipment",
            "other"
          ],
          "enumLabels": {
            "staff": "پرسنل / آرایشگر",
            "chair": "صندلی",
            "room": "اتاق",
            "table": "میز",
            "court": "زمین",
            "equipment": "تجهیزات",
            "other": "سایر"
          },
          "default": "staff"
        },
        "title": {
          "type": "string",
          "label": "سمت / تخصص",
          "description": "عنوان شغلی یا تخصص آرایشگر"
        },
        "bio": {
          "type": "string",
          "label": "معرفی",
          "description": "توضیحات کوتاه درباره سابقه و سبک کاری"
        },
        "avatar": {
          "type": "string",
          "label": "تصویر پروفایل",
          "description": "نشانی تصویر آرایشگر",
          "format": "image"
        },
        "color": {
          "type": "string",
          "label": "رنگ تقویم",
          "description": "کد رنگ نمایش در تقویم مدیریت"
        },
        "capacity": {
          "type": "number",
          "label": "ظرفیت هم‌زمان",
          "description": "تعداد رزرو هم‌زمان مجاز برای این منبع",
          "min": 1,
          "default": 1
        },
        "sortOrder": {
          "type": "number",
          "label": "ترتیب نمایش",
          "description": "اولویت نمایش در لیست آرایشگرها",
          "default": 0
        },
        "workingHoursNote": {
          "type": "string",
          "label": "یادداشت ساعت کاری",
          "description": "توضیح متنی درباره شیفت یا روزهای حضور"
        },
        "active": {
          "type": "boolean",
          "label": "فعال",
          "description": "آیا در رزرو آنلاین نمایش داده شود",
          "default": true
        }
      }
    }
  },
  {
    "name": "booking_service",
    "schemaDefinition": {
      "label": "خدمات و پکیج‌ها",
