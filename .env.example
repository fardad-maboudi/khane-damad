# Joorchin backend for the booking seam (site/src/api/joorchin.js).
# Copy to `.env.local` and fill in the app id; without it the site keeps its
# local demo fallback and never calls the network.
VITE_JOORCHIN_APP_ID=

# Optional. `demo` keeps the bundled demo data even when an app id is set;
# anything else (or omitting it) means live.
VITE_API_MODE=live

# Optional, keep empty for production. Leave blank to use https://api.joorchin.ai;
# set https://api.joorchin.site only when the app lives on staging.
VITE_JOORCHIN_SERVER_URL=
