{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./site/src/*"]
    }
  },
  "include": ["site/src"],
  "exclude": ["node_modules", "dist", "site/dist"]
}
